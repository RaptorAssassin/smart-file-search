{
    folder_names: [
        // Dev / build trash (trash by name anywhere, prunes the walk)
        "node_modules",
        ".git",
        ".svn",
        ".hg",
        "target",
        "build",
        "dist",
        "out",
        "bin",
        "obj",
        ".next",
        ".nuxt",
        ".venv",
        "venv",
        "__pycache__",
        ".pytest_cache",
        ".mypy_cache",
        ".ruff_cache",
        ".tox",
        ".nox",
        ".gradle",
        ".m2",
        ".cargo",
        ".cache",
        ".yarn",
        ".pnpm-store",
        ".turbo",
        ".parcel-cache",
        ".eslintcache",
        ".dart_tool",
        ".idea",
        ".vscode",
        ".cursor",
        ".terraform",
        ".serverless",
        "vendor",
        "bower_components",
        "site-packages",
        "Pods",
        "DerivedData",
        "xcuserdata",
        ".build",
        ".swiftpm",
        ".angular",
        ".vercel",
        ".npm",
        "temp",
        "tmp",
        "logs",
        "cache",
        "coverage",
        "htmlcov",

        // Trash / recycle (anywhere)
        "$RECYCLE.BIN",
        ".Trash",
        ".Trashes",
        ".Spotlight-V100",
        ".fseventsd",
        ".TemporaryItems",
        "System Volume Information",
        "lost+found",

        // Tool / app caches (home dot-folders are regenerable, never user content)
        ".rustup",
        ".lunarclient",
        ".GamingRoot",
        ".local",
        ".config",
        ".ollama",
        ".continue",
        ".claude",
        ".copilot",
        ".wakatime",
        ".bun",
        ".vscode-shared",
        "IntelGraphicsProfiles",

        // Installed runtimes (analogous to node_modules - not user content)
        "Python314",

        // Per-user OS state that is always trash regardless of location
        "AppData",
    ],
    extensions: [
        // Temp / backup / junk
        "tmp",
        "temp",
        "log",
        "old",
        "orig",
        "bak",
        "backup",
        "swp",
        "swo",
        "swn",
        "lock",
        "part",
        "partial",
        "crdownload",
        "download",
        "dmp",
        "mdmp",
        "cache",

        // Compiled / binary artifacts
        "pyc",
        "pyo",
        "pyd",
        "o",
        "a",
        "lo",
        "lib",
        "pdb",
        "class",
        "sys",
        "exe",
        "dll",
        "so",
        "dylib",

        // Archives / installers / packages (no searchable content)
        "msi",
        "msu",
        "appx",
        "appxbundle",
        "cab",
        "pkg",
        "deb",
        "rpm",
        "iso",
        "dmg",
        "apk",
        "jar",
        "war",
        "ear",
        "whl",
        "nupkg",
        "zip",
        "7z",
        "rar",
        "tar",
        "gz",
        "tgz",
        "xz",
        "bz2",
        "zst",
    ],
    path_patterns: [
        // The walker yields paths rooted at "/" (e.g. "/Windows\\System32\\x.dll").
        // Root-anchored "{/X,/X/**}" matches the dir itself (so the walk prunes it)
        // and all of its contents, but NEVER a same-named user folder elsewhere.
        // Any-depth "**/X/**" is only used for per-user paths (AppData-style).

        // Windows system dirs (root only)
        "{/Windows,/Windows/**}",
        "{/Windows.old,/Windows.old/**}",
        "{/$WINDOWS.~BT,/$WINDOWS.~BT/**}",
        "{/$WINDOWS.~WS,/$WINDOWS.~WS/**}",
        "{/Program Files,/Program Files/**}",
        "{/Program Files (x86),/Program Files (x86)/**}",
        "{/ProgramData,/ProgramData/**}",
        "{/PerfLogs,/PerfLogs/**}",
        "{/Recovery,/Recovery/**}",
        "{/RecoveryImage,/RecoveryImage/**}",
        "{/System Reserved,/System Reserved/**}",
        "{/Intel,/Intel/**}",
        "{/AMD,/AMD/**}",
        "{/NVIDIA,/NVIDIA/**}",
        "{/XboxGames,/XboxGames/**}",
        "{/Drivers,/Drivers/**}",
        "{/OneDriveTemp,/OneDriveTemp/**}",
        "{/inetpub,/inetpub/**}",
        "{/OEM,/OEM/**}",
        "{/Temp,/Temp/**}",
        "/*.cab",

        // Windows root-level system files
        "**/hiberfil.sys",
        "**/pagefile.sys",
        "**/swapfile.sys",

        // Windows user-level trash / caches
        "**/Desktop.ini",
        "**/Thumbs.db",
        "**/.DS_Store",
        "**/NTUSER.DAT*",
        "{**/Users/Default,**/Users/Default/**}",

        // Unity regenerated caches
        "{**/Library/PackageCache,**/Library/PackageCache/**}",
        "{**/Library/ScriptAssemblies,**/Library/ScriptAssemblies/**}",
        "{**/Library/PlayerDataCache,**/Library/PlayerDataCache/**}",
        "{**/Library/Artifacts,**/Library/Artifacts/**}",

        // macOS
        "{**/Library/Caches,**/Library/Caches/**}",
        "{**/private/var,**/private/var/**}",
        "{/System,/System/**}",
        "{/Volumes,/Volumes/**}",
        "{/.Trash,/.Trash/**}",
        "{/.Trashes,/.Trashes/**}",

        // Linux system paths
        "{/proc,/proc/**}",
        "{/sys,/sys/**}",
        "{/dev,/dev/**}",
        "{/run,/run/**}",
        "{/tmp,/tmp/**}",
        "{/mnt,/mnt/**}",
        "{/media,/media/**}",
        "{/boot,/boot/**}",
        "{/etc,/etc/**}",
        "{/usr,/usr/**}",
        "{/lib,/lib/**}",
        "{/lib64,/lib64/**}",
        "{/sbin,/sbin/**}",
        "{/var,/var/**}",
        "{/lost+found,/lost+found/**}",
        "{/snap,/snap/**}",
    ]
}