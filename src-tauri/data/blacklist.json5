{
    folder_names: [
        // Dev / build trash
        "node_modules",
        ".git",
        ".svn",
        ".hg",
        "target",
        "build",
        "dist",
        "out",
        "bin",
        "obj",
        ".next",
        ".nuxt",
        ".venv",
        "venv",
        "__pycache__",
        ".pytest_cache",
        ".mypy_cache",
        ".ruff_cache",
        ".tox",
        ".nox",
        ".gradle",
        ".m2",
        ".cargo",
        ".cache",
        ".yarn",
        ".pnpm-store",
        ".turbo",
        ".parcel-cache",
        ".eslintcache",
        ".dart_tool",
        ".idea",
        ".vscode",
        ".cursor",
        ".terraform",
        ".serverless",
        "vendor",

        // Trash / recycle
        "$RECYCLE.BIN",
        "$Recycle.Bin",
        ".Trash",
        ".Trashes",
        ".Spotlight-V100",
        ".fseventsd",
        ".TemporaryItems",
        "System Volume Information",
        "lost+found",

        // Windows system
        "Windows",
        "WinSxS",
        "SoftwareDistribution",
        "System32",
        "SysWOW64",
        "Program Files",
        "Program Files (x86)",
        "ProgramData",
        "AppData",
        "PerfLogs",
        "Windows.old",
        "$WINDOWS.~BT",
        "$WINDOWS.~WS",
        "Recovery",
        "RecoveryImage",
        "System Reserved",
        "Intel",
        "AMD",
        "NVIDIA",
        "XboxGames",
        "Drivers",
        "OneDriveTemp",

        // macOS system
        "System",
        "Volumes",

        // Linux root dirs
        "proc",
        "sys",
        "dev",
        "tmp",
        "run",
        "mnt",
        "media",

        // Tool / app caches (anything under a home-dotfolder is regenerable)
        ".rustup",
        ".lunarclient",
        ".GamingRoot",
    ],
    extensions: [
        "tmp",
        "temp",
        "log",
        "old",
        "orig",
        "bak",
        "backup",
        "swp",
        "swo",
        "swn",
        "lock",
        "part",
        "partial",
        "crdownload",
        "download",
        "dmp",
        "mdmp",
        "cache",
        "pyc",
        "pyo",
        "o",
        "pdb",
        "sys",
        "exe",
        "dll",
        "so",
        "dylib",
        "msi",
        "msu",
        "appx",
        "appxbundle",
        "cab",
        "pkg",
        "deb",
        "rpm",
        "iso",
        "dmg",
    ],
    path_patterns: [
        // Matches both drive-less roots ("/Windows/...") and drive-prefixed
        // paths ("C:\\Windows\\..."), since the walker yields paths rooted at "/".
        "**/Windows/**",
        "**/Windows.old/**",
        "**/$WINDOWS.~BT/**",
        "**/$WINDOWS.~WS/**",
        "**/Program Files/**",
        "**/Program Files (x86)/**",
        "**/ProgramData/**",
        "**/PerfLogs/**",
        "**/System Volume Information/**",
        "**/$Recycle.Bin/**",
        "**/$RECYCLE.BIN/**",
        "**/Recovery/**",
        "**/System Reserved/**",
        "**/Intel/**",
        "**/AMD/**",
        "**/NVIDIA/**",
        "**/XboxGames/**",
        "**/Drivers/**",
        "**/hiberfil.sys",
        "**/pagefile.sys",
        "**/swapfile.sys",

        // Windows root-level installer / Microsoft Gaming leftovers
        "/.GamingRoot",
        "/*.cab",

        // Windows user-level trash / caches
        "**/AppData/**",
        "**/Desktop.ini",
        "**/Thumbs.db",
        "**/.DS_Store",

        // Unity regenerated caches
        "**/Library/PackageCache/**",
        "**/Library/ScriptAssemblies/**",
        "**/Library/PlayerDataCache/**",
        "**/Library/Artifacts/**",

        // macOS
        "**/Library/Caches/**",
        "**/private/var/**",
        "/System/**",
        "/Volumes/**",
        "/.Trash/**",
        "/.Trashes/**",

        // Linux system paths
        "/proc/**",
        "/sys/**",
        "/dev/**",
        "/run/**",
        "/tmp/**",
        "/boot/**",
        "/etc/**",
        "/usr/**",
        "/lib/**",
        "/lib64/**",
        "/sbin/**",
        "/var/**",
        "/lost+found/**",
        "/snap/**",
    ]
}
