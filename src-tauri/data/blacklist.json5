{
    folder_names: [
        "node_modules",
        ".git",
        "target",
        "build",
        ".next",
        ".venv",
        "dist",
        "out",
        "bin",
        "obj",
        "temp",
        "__pycache__",
        "$RECYCLE.BIN",

        // Windows
        "Windows",
        "Program Files",
        "Program Files (x86)",
        "ProgramData",
        "Drivers",
        "XboxGames",
        "System Volume Information",
        "AppData",

        // macOS
        "System",
        "Volumes",
        ".Trashes",
        "private/var",

        // Linux
        "proc",
        "sys",
        "dev",
        "tmp",
        "run",
        "mnt",
        "media",
    ],
    extensions: [
        "tmp",
        "log",
        "bak",
        "swp",
        "iso",
        "dmg",
        "exe",
        "log",
        "dll",
        "so",
    ],
    path_patterns: [
        "**/AppData/Local/Temp/**",
        "**/Library/Caches/**",
        "/proc/**",
        "/sys/**",
        "/dev/**",
        "/run/**",
        "/tmp/**",
        "C:/Windows/**",
        "C:/$Recycle.Bin/**"
    ]
}