{
    folder_names: [
        "node_modules",
        ".git",
        "target",
        "build",
        ".next",
        ".venv",
        "dist",
        "out",
        "bin",
        "obj",
        "temp",
        "__pycache__",
        "$RECYCLE.BIN",

        // Windows

        // macOS
        "System",
        "Volumes",
        ".Trashes",

        // Linux
        "proc",
        "sys",
        "dev",
        "tmp",
        "run",
        "mnt",
        "media",
    ],
    extensions: [
        "tmp",
        "log",
        "bak",
        "swp",
        "iso",
        "dmg",
        "exe",
        "dll",
        "so",
    ],
    path_patterns: [
        // Windows
        "C:/Program Files/**",
        "C:/Program Files (x86)/**",
        "C:/ProgramData/**",
        "C:/Drivers/**",
        "C:/XboxGames/**",
        "C:/System Volume Information/**",
        "C:/Users/**/AppData/**",
        "**/AppData/Local/Temp/**",
        "**/Library/Caches/**",
        "/proc/**",
        "/sys/**",
        "/dev/**",
        "/run/**",
        "/tmp/**",
        "C:/Windows/**",
        "C:/$Recycle.Bin/**",
        "**/private/var/**",
    ]
}